<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sweet Bites | Alta Repostería Artesanal</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="" crossorigin="anonymous">

    <style>
        :root {
            --primary: #4A2E1B; /* Chocolate lujoso */
            --accent: #D4A373; /* Dorado vainilla */
            --bg-light: #FDFBF7; /* Crema suave */
            --text-dark: #2C2C2C;
            --white: #FFFFFF;
            --shadow: 0 10px 30px rgba(74, 46, 27, 0.08);
            --transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            line-height: 1.6;
        }

        h1, h2, h3, .brand {
            font-family: 'Playfair Display', serif;
        }

        /* HEADER & NAVIGATION */
        header {
            background-color: var(--white);
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 5%;
        }

        .brand {
            font-size: 1.8rem;
            color: var(--primary);
            font-weight: 700;
            letter-spacing: 1px;
            cursor: pointer;
        }

        .brand span {
            color: var(--accent);
        }

        .nav-links {
            display: flex;
            gap: 1.5rem;
            list-style: none;
        }

        .nav-links button {
            background: none;
            border: none;
            font-family: 'Poppins', sans-serif;
            font-size: 0.95rem;
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer;
            transition: var(--transition);
            padding: 0.5rem 0.8rem;
            border-radius: 20px;
        }

        .nav-links button:hover, .nav-links button.active {
            color: var(--white);
            background-color: var(--primary);
        }

        .cart-btn {
            background-color: var(--primary);
            color: var(--white);
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: var(--transition);
        }

        .cart-btn:hover {
            background-color: var(--accent);
            transform: translateY(-2px);
        }

        .cart-count {
            background-color: var(--accent);
            color: var(--primary);
            padding: 2px 8px;
            border-radius: 50%;
            font-weight: 700;
            font-size: 0.85rem;
        }

        /* TAB CONTENT SYSTEM */
        .tab-content {
            display: none;
            opacity: 0;
            transform: translateY(15px);
            transition: opacity 0.4s ease, transform 0.4s ease;
            min-height: 75vh;
        }

        .tab-content.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        /* HERO SECTION (INICIO) */
        .hero {
            background: linear-gradient(rgba(44, 44, 44, 0.65), rgba(44, 44, 44, 0.65)), url('https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
            color: var(--white);
            text-align: center;
            padding: 7rem 1.5rem;
            margin-bottom: 3rem;
            border-radius: 0 0 25px 25px;
        }

        .hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 650px;
            margin: 0 auto 2rem;
            font-weight: 300;
        }

        .btn-primary-hero {
            background-color: var(--accent);
            color: var(--primary);
            border: none;
            padding: 0.9rem 2.2rem;
            border-radius: 30px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-primary-hero:hover {
            background-color: var(--white);
            transform: scale(1.05);
        }

        .badge-exclusive {
            display: inline-block;
            background-color: var(--accent);
            color: var(--primary);
            padding: 5px 15px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* CONTAINER STYLES */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .section-subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 2.5rem;
            font-size: 1rem;
        }

        /* FILTERS */
        .category-filters {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--white);
            border: 1px solid #ddd;
            padding: 0.6rem 1.4rem;
            border-radius: 20px;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            transition: var(--transition);
        }

        .filter-btn.active, .filter-btn:hover {
            background-color: var(--primary);
            color: var(--white);
            border-color: var(--primary);
        }

        /* GRID & CARDS */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .card {
            background: var(--white);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(74, 46, 27, 0.12);
        }

        .card-img-container {
            height: 220px;
            overflow: hidden;
            position: relative;
        }

        .card-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .card:hover .card-img-container img {
            transform: scale(1.05);
        }

        .tag-special {
            position: absolute;
            top: 15px;
            left: 15px;
            background-color: var(--primary);
            color: var(--white);
            padding: 4px 12px;
            font-size: 0.75rem;
            border-radius: 6px;
            font-weight: 500;
        }

        .card-content {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .card-title {
            font-size: 1.35rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .card-desc {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 1.2rem;
            flex-grow: 1;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
        }

        .price {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary);
        }

        .btn-add {
            background-color: transparent;
            border: 2px solid var(--primary);
            color: var(--primary);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
        }

        .btn-add:hover {
            background-color: var(--primary);
            color: var(--white);
        }

        /* ABOUT & TEAM STYLES */
        .content-box {
            background: var(--white);
            padding: 3rem;
            border-radius: 20px;
            box-shadow: var(--shadow);
            max-width: 1000px;
            margin: 2rem auto;
            text-align: center;
        }

        .content-box h2 {
            color: var(--primary);
            margin-bottom: 1.2rem;
            font-size: 2.2rem;
        }

        .content-box p {
            color: #555;
            margin-bottom: 1rem;
            font-size: 1.05rem;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 2rem;
            margin-top: 2.5rem;
            text-align: left;
        }

        .team-card {
            background: var(--bg-light);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            transition: var(--transition);
        }

        .team-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(74, 46, 27, 0.1);
        }

        .team-img {
            height: 200px;
            width: 100%;
            object-fit: cover;
        }

        .team-info {
            padding: 1.2rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .team-name {
            font-size: 1.1rem;
            color: var(--primary);
            font-weight: 700;
            font-family: 'Playfair Display', serif;
        }

        .team-role {
            font-size: 0.8rem;
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 0.4rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .team-desc {
            font-size: 0.82rem;
            color: #555;
            margin-bottom: 0.6rem;
        }

        .team-bio {
            font-size: 0.78rem;
            color: #666;
            margin-bottom: 0.8rem;
            font-style: italic;
        }

        .team-contribution {
            font-size: 0.78rem;
            color: var(--primary);
            background: var(--white);
            padding: 8px;
            border-radius: 6px;
            border-left: 3px solid var(--accent);
            margin-top: auto;
        }

        /* CONTACT CARDS */
        .contact-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .contact-card {
            background: var(--bg-light);
            padding: 1.5rem;
            border-radius: 12px;
            text-align: center;
        }

        .contact-card i {
            font-size: 1.8rem;
            color: var(--accent);
            margin-bottom: 0.8rem;
        }

        /* CART DRAWER */
        .cart-drawer {
            position: fixed;
            top: 0;
            right: -420px;
            width: 100%;
            max-width: 420px;
            height: 100%;
            background-color: var(--white);
            box-shadow: -5px 0 25px rgba(0,0,0,0.15);
            z-index: 2000;
            transition: right 0.4s cubic-bezier(0.77, 0, 0.175, 1);
            display: flex;
            flex-direction: column;
        }

        .cart-drawer.open {
            right: 0;
        }

        .cart-header {
            padding: 1.5rem;
            background-color: var(--primary);
            color: var(--white);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .close-cart {
            background: none;
            border: none;
            color: var(--white);
            font-size: 1.5rem;
            cursor: pointer;
        }

        .cart-body {
            padding: 1.5rem;
            overflow-y: auto;
            flex-grow: 1;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }

        .cart-item-info h4 {
            font-size: 0.95rem;
            color: var(--primary);
        }

        .cart-item-info p {
            font-size: 0.85rem;
            color: #777;
        }

        .cart-item-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cart-item-controls button {
            background: #eee;
            border: none;
            width: 25px;
            height: 25px;
            border-radius: 50%;
            cursor: pointer;
            font-weight: bold;
        }

        .cart-footer-section {
            padding: 1.5rem;
            background-color: #f9f9f9;
            border-top: 1px solid #eee;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 1rem;
        }

        /* CHECKOUT FORM */
        .checkout-form {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 1rem;
        }

        .checkout-form input, .checkout-form textarea {
            padding: 0.8rem;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
        }

        .checkout-form input:focus, .checkout-form textarea:focus {
            outline: none;
            border-color: var(--accent);
        }

        .btn-checkout {
            background-color: var(--primary);
            color: var(--white);
            border: none;
            padding: 0.9rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 5px;
        }

        .btn-checkout:hover {
            background-color: var(--accent);
            color: var(--primary);
        }

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1500;
            display: none;
        }

        .overlay.active {
            display: block;
        }

        /* FOOTER */
        footer {
            background-color: var(--primary);
            color: var(--white);
            text-align: center;
            padding: 2.5rem 1rem;
            margin-top: 4rem;
        }

        footer p {
            font-size: 0.9rem;
            opacity: 0.8;
        }

        @media (max-width: 768px) {
            .nav-links { display: none; }
            .hero { padding: 5rem 1rem; }
            .hero h1 { font-size: 2.2rem; }
        }
    </style>
</head>
<body>

    <!-- Header & Interactive Navigation Tabs -->
    <header role="navigation" aria-label="Navegación principal">
        <div class="brand" onclick="switchTab('home')" role="link" tabindex="0" aria-label="Ir a Inicio">Sweet <span>Bites</span></div>
        <ul class="nav-links" role="menubar" aria-label="Enlaces de la página">
            <li><button role="menuitem" onclick="switchTab('home')" id="btn-home" class="active">Inicio</button></li>
            <li><button role="menuitem" onclick="switchTab('menu')" id="btn-menu">Menú & Catálogo</button></li>
            <li><button role="menuitem" onclick="switchTab('about')" id="btn-about">Nuestra Esencia</button></li>
            <li><button role="menuitem" onclick="switchTab('contact')" id="btn-contact">Contacto</button></li>
        </ul>
        <button class="cart-btn" onclick="toggleCart()" aria-controls="cartDrawer" aria-expanded="false" id="openCartBtn">
            <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i> Pedido <span class="cart-count" id="cartCount">0</span>
        </button>
    </header>

    <!-- ================= TAB 1: INICIO ================= -->
    <section id="home" class="tab-content active" aria-labelledby="btn-home">
        <div class="hero">
            <span class="badge-exclusive">Alta Repostería Artesanal</span>
            <h1>El placer hecho postre</h1>
            <p>Descubre nuestra especialidad estrella, el Crème Brûlée, y un catálogo exclusivo diseñado para despertar tus sentidos.</p>
            <button class="btn-primary-hero" onclick="switchTab('menu')">Explorar Menú Completo</button>
        </div>
        <div class="container">
            <h2 class="section-title">Nuestra Creación Insignia</h2>
            <p class="section-subtitle">El favorito absoluto de nuestros clientes más exigentes</p>
            <div class="grid" id="featuredGrid" aria-live="polite">
                <!-- Inyectado dinámicamente -->
            </div>
        </div>
    </section>

    <!-- ================= TAB 2: MENÚ & CATÁLOGO ================= -->
    <section id="menu" class="tab-content" aria-labelledby="btn-menu">
        <div class="container">
            <h2 class="section-title">Catálogo de Postres Exclusivos</h2>
            <p class="section-subtitle">Selecciona tus favoritos y arma tu pedido personalizado al instante</p>
            
            <div class="category-filters" role="tablist" aria-label="Filtros de categoría">
                <button class="filter-btn active" onclick="filterMenu('all', event)">Todos</button>
                <button class="filter-btn" onclick="filterMenu('Destacado', event)">Estrella</button>
                <button class="filter-btn" onclick="filterMenu('Especialidad', event)">Especialidades</button>
                <button class="filter-btn" onclick="filterMenu('Gourmet', event)">Gourmet</button>
                <button class="filter-btn" onclick="filterMenu('Frutal', event)">Frutales</button>
            </div>

            <div class="grid" id="productGrid" aria-live="polite">
                <!-- Inyectado dinámicamente -->
            </div>
        </div>
    </section>

    <!-- ================= TAB 3: NUESTRA ESENCIA (INCLUYE EQUIPO) ================= -->
    <section id="about" class="tab-content" aria-labelledby="btn-about">
        <div class="container">
            <div class="content-box" style="max-width: 1200px;">
                <h2>El Arte de Endulzar Cada Momento</h2>
                <p>En <strong>Sweet Bites</strong>, cada postre es concebido bajo rigurosos estándares de alta cocina. Combinamos técnicas tradicionales francesas con ingredientes de origen único, como vainilla Bourbon de Madagascar y chocolates selectos.</p>
                <p>Nuestra misión no es solo vender un postre, sino regalarte una experiencia memorable que convierta lo ordinario en extraordinario.</p>

                <hr style="border: 0; border-top: 1px solid #eee; margin: 2.5rem 0;">

                <h2 style="font-size: 2rem; margin-bottom: 0.5rem;">Nuestro Equipo Fundador y Culinario</h2>
                <p style="color: #666; margin-bottom: 2rem;">Conoce a los 8 profesionales apasionados que hacen posible la magia y excelencia de Sweet Bites.</p>

                <div class="team-grid">
                    <!-- Integrante 1 -->
                    <div class="team-card">
                        <img src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c?auto=format&fit=crop&w=500&q=80" alt="Isabella Vance" class="team-img">
                        <div class="team-info">
                            <span class="team-role">Chef Ejecutiva</span>
                            <h3 class="team-name">Isabella Vance</h3>
                            <p class="team-desc">Maestra repostera con formación en París y especialidad en alta cocina dulce.</p>
                            <p class="team-bio">"La perfección radica en el balance exacto entre temperatura, técnica y amor por el detalle."</p>
                            <div class="team-contribution"><strong>Aporte:</strong> Creación de la receta insigne del Crème Brûlée y curaduría de ingredientes de origen.</div>
                        </div>
                    </div>

                    <!-- Integrante 2 -->
                    <div class="team-card">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=500&q=80" alt="Mateo Almonte" class="team-img">
                        <div class="team-info">
                            <span class="team-role">Director de Mercadeo</span>
                            <h3 class="team-name">Mateo Almonte</h3>
                            <p class="team-desc">Especialista en psicología del consumidor y estrategias culinarias sensoriales.</p>
                            <p class="team-bio">"El apetito comienza en la mente a través de la narrativa y la estética visual."</p>
                            <div class="team-contribution"><strong>Aporte:</strong> Arquitectura de descripciones sensoriales del menú y optimización de la experiencia de usuario.</div>
                        </div>
                    </div>

                    <!-- Integrante 3 -->
                    <div class="team-card">
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=500&q=80" alt="Sofía Laurent" class="team-img">
                        <div class="team-info">
                            <span class="team-role">Maestra Pastelera</span>
                            <h3 class="team-name">Sofía Laurent</h3>
                            <p class="team-desc">Experta en pastelería francesa y texturas horneadas de precisión milimétrica.</p>
                            <p class="team-bio">"Cada capa cuenta una historia de paciencia y dedicación artesanal."</p>
                            <div class="team-contribution"><strong>Aporte:</strong> Desarrollo y estandarización de las tartas de queso vascas y macarons franceses.</div>
                        </div>
                    </div>

                    <!-- Integrante 4 -->
                    <div class="team-card">
                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=500&q=80" alt="Alejandro Morel" class="team-img">
                        <div class="team-info">
                            <span class="team-role">Arquitecto Digital</span>
                            <h3 class="team-name">Alejandro Morel</h3>
                            <p class="team-desc">Ingeniero en tecnología y ciberseguridad aplicada a plataformas digitales.</p>
                            <p class="team-bio">"La seguridad y la fluidez tecnológica son los cimientos de la confianza moderna."</p>
                            <div class="team-contribution"><strong>Aporte:</strong> Programación y unificación técnica de la plataforma web interactiva todo en uno.</div>
                        </div>
                    </div>

                    <!-- Integrante 5 -->
                    <div class="team-card">
                        <img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=500&q=80" alt="Camila Rossi" class="team-img">
                        <div class="team-info">
                            <span class="team-role">Innovación de Menú</span>
                            <h3 class="team-name">Camila Rossi</h3>
                            <p class="team-desc">Investigadora de tendencias gastronómicas contemporáneas y repostería fusión.</p>
                            <p class="team-bio">"Innovar en la repostería es atreverse a explorar nuevas emociones en el paladar."</p>
                            <div class="team-contribution"><strong>Aporte:</strong> Incorporación de la línea gourmet de chocolate oscuro con corazón fundente y postres frutales.</div>
                        </div>
                    </div>

                    <!-- Integrante 6 -->
                    <div class="team-card">
                        <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=500&q=80" alt="Gabriel Vargas" class="team-img">
                        <div class="team-info">
                            <span class="team-role">Control de Calidad</span>
                            <h3 class="team-name">Gabriel Vargas</h3>
                            <p class="team-desc">Auditor de procesos culinarios y estándares de frescura internacional.</p>
                            <p class="team-bio">"La excelencia no es un acto, es un hábito constante en cada producción."</p>
                            <div class="team-contribution"><strong>Aporte:</strong> Implementación del protocolo de frescura diaria y supervisión de empaques seguros.</div>
                        </div>
                    </div>

                    <!-- Integrante 7 -->
                    <div class="team-card">
                        <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=500&q=80" alt="Valeria Cruz" class="team-img">
                        <div class="team-info">
                            <span class="team-role">Experiencia del Cliente</span>
                            <h3 class="team-name">Valeria Cruz</h3>
                            <p class="team-desc">Experta en atención personalizada y satisfacción del consumidor de alta gama.</p>
                            <p class="team-bio">"Una sonrisa y un servicio impecable completan la dulzura de un buen postre."</p>
                            <div class="team-contribution"><strong>Aporte:</strong> Diseño del sistema de flujo de pedidos rápidos y atención personalizada al cliente.</div>
                        </div>
                    </div>

                    <!-- Integrante 8 -->
                    <div class="team-card">
                        <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=500&q=80" alt="Lucas Pimentel" class="team-img">
                        <div class="team-info">
                            <span class="team-role">Director Creativo</span>
                            <h3 class="team-name">Lucas Pimentel</h3>
                            <p class="team-desc">Artista visual especializado en iluminación y escenografía de alimentos.</p>
                            <p class="team-bio">"Capturar la textura perfecta es lograr que el espectador pueda saborear con los ojos."</p>
                            <div class="team-contribution"><strong>Aporte:</strong> Dirección visual, selección de fotografía gastronómica de alta fidelidad y armonía estética.</div>
                        </div>
                    </div>
                </div>

                <button class="btn-primary-hero" style="margin-top: 2.5rem;" onclick="switchTab('menu')">Ver el Menú Ahora</button>
            </div>
        </div>
    </section>

    <!-- ================= TAB 4: CONTACTO ================= -->
    <section id="contact" class="tab-content" aria-labelledby="btn-contact">
        <div class="container">
            <div class="content-box">
                <h2>Comunícate con Sweet Bites</h2>
                <p>¿Tienes alguna consulta especial o deseas realizar un pedido personalizado para eventos? Nuestro equipo está para atenderte.</p>
                
                <div class="contact-info-grid">
                    <div class="contact-card">
                        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                        <h4>Ubicación</h4>
                        <p style="font-size: 0.9rem; color: #666; margin-top: 5px;">Santo Domingo, Rep. Dom.</p>
                    </div>
                    <div class="contact-card">
                        <i class="fa-solid fa-phone" aria-hidden="true"></i>
                        <h4>Teléfono / WhatsApp</h4>
                        <p style="font-size: 0.9rem; color: #666; margin-top: 5px;">+1 (809) 555-0192</p>
                    </div>
                    <div class="contact-card">
                        <i class="fa-solid fa-clock" aria-hidden="true"></i>
                        <h4>Horario</h4>
                        <p style="font-size: 0.9rem; color: #666; margin-top: 5px;">Lun - Dom: 10:00 AM - 9:00 PM</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Cart Drawer / Sidebar -->
    <div class="overlay" id="overlay" onclick="toggleCart()" aria-hidden="true"></div>
    <aside class="cart-drawer" id="cartDrawer" aria-hidden="true" aria-labelledby="openCartBtn" role="dialog" aria-modal="true">
        <div class="cart-header">
            <h3>Tu Carrito de Pedidos</h3>
            <button class="close-cart" onclick="toggleCart()" aria-label="Cerrar carrito" id="closeCartBtn">&times;</button>
        </div>
        <div class="cart-body" id="cartItems">
            <p style="text-align: center; color: #777; margin-top: 2rem;">Tu carrito está vacío.</p>
        </div>
        <div class="cart-footer-section" id="cartFooter" style="display: none;">
            <div class="total-row">
                <span>Total a Pagar:</span>
                <span id="cartTotal">$0.00</span>
            </div>
            <form class="checkout-form" id="checkoutForm" onsubmit="finalizeOrder(event)">
                <input type="text" id="clientName" placeholder="Tu Nombre Completo" required>
                <input type="tel" id="clientPhone" placeholder="Teléfono de Contacto" required>
                <textarea id="clientAddress" placeholder="Dirección exacta de entrega (Calle, Número, Sector)" rows="2" required></textarea>
                <button type="submit" class="btn-checkout">Confirmar Pedido</button>
            </form>
        </div>
    </aside>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Sweet Bites. Todos los derechos reservados. | Alta Repostería Artesanal.</p>
    </footer>

    <!-- Script JavaScript Funcional -->
    <script>
        const products = [
            {
                id: 1,
                name: "Crème Brûlée",
                category: "Destacado",
                price: 8.50,
                description: "Delicada crema ligera infusionada con vainilla Bourbon de Madagascar, cubierta con una crujiente capa de caramelo tostado al momento.",
                image: "https://images.unsplash.com/photo-1470124182917-cc6e71b22ecc?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 2,
                name: "Tarta de Queso Vasca",
                category: "Especialidad",
                price: 9.00,
                description: "Textura cremosa inigualable con un tostado exterior perfecto al horno que realza notas sutiles de caramelo artesanal.",
                image: "https://images.unsplash.com/photo-1533134242443-d4fd215305ad?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 3,
                name: "Tiramisú Tradicional",
                category: "Especialidad",
                price: 7.50,
                description: "Capas de bizcocho empapadas en espresso intenso, crema suave de mascarpone italiano y finísimo cacao amargo.",
                image: "https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 4,
                name: "Volcán de Chocolate Intenso",
                category: "Gourmet",
                price: 8.00,
                description: "Bizcocho tibio de chocolate oscuro con corazón fundente que fluye al primer corte. Elaborado con cacao 70%.",
                image: "https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 5,
                name: "Macarons Franceses (Caja x6)",
                category: "Gourmet",
                price: 12.00,
                description: "Exquisitos merengues de almendra crujientes por fuera y suaves por dentro, rellenos de ganaches finos.",
                image: "https://images.unsplash.com/photo-1569864358642-9d1684040f43?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 6,
                name: "Cheesecake de Frutos Rojos",
                category: "Frutal",
                price: 8.50,
                description: "Base crujiente de galleta mantequillosa, crema de queso sedosa y un vibrante coulis de frutos silvestres frescos.",
                image: "https://images.unsplash.com/photo-1524351199678-941a58a3df50?auto=format&fit=crop&w=600&q=80"
            }
        ];

        // Estado del carrito (se persistirá en localStorage)
        let cart = [];

        // --- UI / Tabs ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.nav-links button').forEach(btn => btn.classList.remove('active'));

            const targetTab = document.getElementById(tabId);
            if (targetTab) {
                targetTab.classList.add('active');
            }

            const targetBtn = document.getElementById(`btn-${tabId}`);
            if (targetBtn) {
                targetBtn.classList.add('active');
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderFeatured() {
            const featuredGrid = document.getElementById('featuredGrid');
            const cremeBrulee = products[0];
            featuredGrid.innerHTML = `
                <div class="card" style="margin: 0 auto; max-width: 380px; width: 100%;">
                    <div class="card-img-container">
                        <span class="tag-special">Estrella</span>
                        <img src="${cremeBrulee.image}" alt="${cremeBrulee.name}">
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">${cremeBrulee.name}</h3>
                        <p class="card-desc">${cremeBrulee.description}</p>
                        <div class="card-footer">
                            <span class="price">$${cremeBrulee.price.toFixed(2)}</span>
                            <button class="btn-add" onclick="addToCart(${cremeBrulee.id})">Agregar</button>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderProducts(filter = 'all') {
            const grid = document.getElementById('productGrid');
            const filteredProducts = filter === 'all' 
                ? products 
                : products.filter(p => p.category === filter);

            if (filteredProducts.length === 0) {
                grid.innerHTML = '<p style="text-align:center; color:#777;">No hay productos para esta categoría.</p>';
                return;
            }

            grid.innerHTML = filteredProducts.map(product => `
                <div class="card">
                    <div class="card-img-container">
                        <span class="tag-special">${product.category}</span>
                        <img src="${product.image}" alt="${product.name}" loading="lazy">
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">${product.name}</h3>
                        <p class="card-desc">${product.description}</p>
                        <div class="card-footer">
                            <span class="price">$${product.price.toFixed(2)}</span>
                            <button class="btn-add" onclick="addToCart(${product.id})">Agregar</button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Recibe el event para poder marcar el botón activo sin depender del objeto global event
        function filterMenu(category, event) {
            if (event && event.target) {
                document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
                event.target.classList.add('active');
            }
            renderProducts(category);
        }

        // --- Carrito ---
        function toggleCart() {
            const drawer = document.getElementById('cartDrawer');
            const overlay = document.getElementById('overlay');
            const openBtn = document.getElementById('openCartBtn');

            const isOpen = drawer.classList.toggle('open');
            overlay.classList.toggle('active', isOpen);
            drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
            openBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

            if (isOpen) {
                // foco en el primer input del formulario para accesibilidad
                setTimeout(() => {
                    const nameInput = document.getElementById('clientName');
                    if (nameInput) nameInput.focus();
                }, 150);
            } else {
                // devolver foco al botón del carrito
                setTimeout(() => {
                    openBtn.focus();
                }, 150);
            }
        }

        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existingItem = cart.find(item => item.id === productId);

            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            saveCart();
            updateCartUI();
            
            const cartBtn = document.querySelector('.cart-btn');
            cartBtn.style.transform = 'scale(1.05)';
            setTimeout(() => cartBtn.style.transform = 'scale(1)', 200);
        }

        function changeQuantity(productId, change) {
            const itemIndex = cart.findIndex(item => item.id === productId);
            if (itemIndex > -1) {
                cart[itemIndex].quantity += change;
                if (cart[itemIndex].quantity <= 0) {
                    cart.splice(itemIndex, 1);
                }
            }
            saveCart();
            updateCartUI();
        }

        function updateCartUI() {
            const cartCount = document.getElementById('cartCount');
            const cartItemsContainer = document.getElementById('cartItems');
            const cartFooter = document.getElementById('cartFooter');
            const cartTotal = document.getElementById('cartTotal');

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartCount.textContent = totalItems;

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = '<p style="text-align: center; color: #777; margin-top: 2rem;">Tu carrito está vacío.</p>';
                cartFooter.style.display = 'none';
                return;
            }

            cartFooter.style.display = 'block';

            cartItemsContainer.innerHTML = cart.map(item => `
                <div class="cart-item" aria-live="polite">
                    <div class="cart-item-info">
                        <h4>${item.name}</h4>
                        <p>$${item.price.toFixed(2)} x ${item.quantity}</p>
                    </div>
                    <div class="cart-item-controls">
                        <button aria-label="Disminuir cantidad" onclick="changeQuantity(${item.id}, -1)">-</button>
                        <span>${item.quantity}</span>
                        <button aria-label="Aumentar cantidad" onclick="changeQuantity(${item.id}, 1)">+</button>
                    </div>
                </div>
            `).join('');

            const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            cartTotal.textContent = `$${total.toFixed(2)}`;
        }

        function finalizeOrder(event) {
            event.preventDefault();
            if (cart.length === 0) {
                alert('Tu carrito está vacío.');
                return;
            }

            const name = document.getElementById('clientName').value.trim();
            const phone = document.getElementById('clientPhone').value.trim();
            const address = document.getElementById('clientAddress').value.trim();

            if (!name || !phone || !address) {
                alert('Por favor completa todos los campos del formulario.');
                return;
            }

            const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            // Mensaje provisional (aquí puedes conectar con un backend o API)
            alert(`¡Pedido Realizado con Éxito!\n\nCliente: ${name}\nTeléfono: ${phone}\nDirección: ${address}\nMonto Total: $${total.toFixed(2)}\n\nNos pondremos en contacto contigo de inmediato para coordinar la entrega.`);

            cart = [];
            saveCart();
            updateCartUI();
            document.getElementById('checkoutForm').reset();
            toggleCart();
        }

        // --- Persistencia con localStorage ---
        function loadCart() {
            try {
                const stored = localStorage.getItem('sb_cart_v1');
                if (stored) {
                    cart = JSON.parse(stored);
                }
            } catch (e) {
                console.warn('No se pudo cargar el carrito desde localStorage.', e);
                cart = [];
            }
        }

        function saveCart() {
            try {
                localStorage.setItem('sb_cart_v1', JSON.stringify(cart));
            } catch (e) {
                console.warn('No se pudo guardar el carrito en localStorage.', e);
            }
        }

        // --- Atajos y accesibilidad global ---
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const drawer = document.getElementById('cartDrawer');
                if (drawer.classList.contains('open')) {
                    toggleCart();
                }
            }
        });

        // Inicialización
        window.onload = function() {
            loadCart();
            renderFeatured();
            renderProducts();
            updateCartUI();
        };
    </script>
</body>
</html>
